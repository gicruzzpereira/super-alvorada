# Copie para .env.local e preencha com os dados SMTP do seu provedor.
ALVORADA_SMTP_HOST=smtp.gmail.com
ALVORADA_SMTP_PORT=465
ALVORADA_SMTP_ENCRYPTION=ssl
ALVORADA_SMTP_USERNAME=seu-endereco@gmail.com
